APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# Local default (no Docker): SQLite file next to backend/
DATABASE_URL=sqlite:///ecocode.db
# Docker / Render: PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ecocode

# LLM provider: ollama | openai | gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional semgrep executable
SEMGREP_BIN=semgrep

# Temporary clone folder for future use
TEMP_REPO_DIR=./temp_repos
